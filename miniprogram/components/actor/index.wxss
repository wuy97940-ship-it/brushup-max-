:host{display:block;width:100%;height:100%}.actor{position:relative;width:100%;height:100%}.layer{position:absolute;top:0;left:0;width:100%;height:100%}
.flying{animation:float 3.2s ease-in-out infinite}@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8rpx)}}
.companion{position:absolute;bottom:0;right:-10%;width:38%;height:38%}
