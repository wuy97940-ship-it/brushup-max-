.study-text{color:inherit;font-size:29rpx;line-height:1.8}.paragraph{display:block;white-space:pre-wrap;overflow-wrap:anywhere}.table-wrap{margin:20rpx 0}.scroll-hint{font-size:22rpx;color:#6b819d;margin-bottom:8rpx}.table-scroll{width:100%;border:1rpx solid #cadbf2;border-radius:12rpx;box-sizing:border-box}.table{min-width:100%;background:#fff}.table-row{display:flex;align-items:stretch;border-bottom:1rpx solid #cadbf2}.table-row:last-child{border-bottom:none}.table-cell{flex:none;width:240rpx;box-sizing:border-box;white-space:pre-wrap;overflow-wrap:anywhere;padding:16rpx 12rpx;font-size:26rpx;line-height:1.6;border-right:1rpx solid #cadbf2}.table-cell:last-child{border-right:none}.table-heading{background:#eaf2ff;font-weight:700}.dark .table{background:#1d3050}.dark .table-heading{background:#263e65}.dark .table-scroll,.dark .table-row,.dark .table-cell{border-color:#3c567c}.dark .scroll-hint{color:#a3b7d3}
