<view class="study-text {{theme==='dark'?'dark':''}}"><block wx:for="{{blocks}}" wx:key="index" wx:for-item="block"><text wx:if="{{block.kind==='text'}}" class="paragraph" user-select>{{block.text}}</text><view wx:else class="table-wrap"><view class="scroll-hint">左右滑动查看完整表格</view><scroll-view scroll-x class="table-scroll"><view class="table" style="width:{{block.width}}rpx"><view wx:for="{{block.rows}}" wx:key="index" wx:for-item="row" wx:for-index="rowIndex" class="table-row {{rowIndex===0?'table-heading':''}}"><text wx:for="{{row}}" wx:key="index" wx:for-item="cell" class="table-cell" user-select>{{cell}}</text></view></view></scroll-view></view></block></view>
