<view class="shell {{theme==='dark'?'dark':''}}">
 <view class="row"><view class="title">精灵猎场</view><button class="secondary small-button" bindtap="home">回首页</button></view>
 <view wx:if="{{saveError||loadError}}" class="save-error">{{loadError||'本次操作尚未保存，进度和奖励以保存成功为准。'}}<button bindtap="retrySave">重试保存或读取</button></view>
 <view wx:if="{{error||audioError}}" class="save-error">{{error||audioError}}<button bindtap="retryResources">重试资源</button></view>
 <include src="../../templates/resources600.wxml"/>
 <view class="sound-controls"><button class="secondary" data-key="music" bindtap="toggleSound">音乐 {{settings.music?'开':'关'}}</button><button class="secondary" data-key="sound" bindtap="toggleSound">音效 {{settings.sound?'开':'关'}}</button><button class="secondary" data-key="reduced_motion" bindtap="toggleSound">{{settings.reduced_motion?'简化动作':'完整动作'}}</button></view>
 <block wx:if="{{lobby}}">
  <view class="card"><view class="subtitle">已通关 {{hunting.eligibleCount}} 道不同客观题</view><view class="muted">精灵狩猎需先通关{{hunting.unlockCount}}道。挑战已学题，通过后投出圆宝球，有机会将新伙伴带回家。</view><view class="biome-buttons"><button wx:for="{{['forest','island','stars']}}" wx:key="*this" class="{{biome===item?'primary':'secondary'}}" data-id="{{item}}" bindtap="chooseBiome">{{item==='forest'?'森林':item==='island'?'海岛':'星空'}}</button></view><button class="primary" disabled="{{!hunting.canHunt||saveError||!g.starter_claimed||mood.energy<=0}}" bindtap="startSpirit">寻找尚未收服的精灵</button></view>
  <view wx:if="{{hunting.lastResult}}" class="card"><view class="subtitle">{{hunting.lastResult.passed?'挑战成功':'这次先回去准备'}}</view><view>{{hunting.lastResult.reason||'考核通过，资格已保留。'}}</view><view class="muted">正确 {{hunting.lastResult.correct||0}} / {{hunting.lastResult.total||0}}</view></view>
  <view class="row section-heading"><view class="subtitle">精灵图鉴 {{hunting.capturedCount}} / 17</view><text class="muted">同行名额 {{hunting.bond.limit}}</text></view>
  <view class="spirit-grid"><view class="card spirit-card" wx:for="{{hunting.spirits}}" wx:key="id"><image wx:if="{{galleryImages[item.id]}}" src="{{galleryImages[item.id]}}" mode="aspectFit" lazy-load="true"/><view wx:else class="image-loading">图片加载中</view><view class="subtitle">{{item.name}}</view><view class="muted">{{item.rarityName}} · {{item.owned?'已收服':'等待相遇'}}</view><view class="muted">{{item.role}}</view><button wx:if="{{item.owned}}" class="secondary" data-id="{{item.id}}" bindtap="equip">{{item.equipped?'取消同行':'一起出发'}}</button><view wx:if="{{item.owned&&!item.equipped&&hunting.companions.length>=hunting.bond.limit&&hunting.bond.limit===2}}"><button wx:for="{{hunting.companions}}" wx:for-item="old" wx:key="*this" class="secondary" data-id="{{item.id}}" data-replace="{{old}}" bindtap="equip">替换{{index+1}}号同行</button></view></view></view>
  <view class="card"><view class="subtitle">主角考核</view><view class="muted">100题客观题，90%通过；300金币定金，成功后1200尾款。</view><view wx:for="{{hunting.heroes}}" wx:key="id" class="hero-exam"><view>{{item.name}} · {{item.owned?'已解锁':item.qualified?'已通过，资格保留':'待考核'}}</view><button wx:if="{{!item.owned}}" class="secondary" data-id="{{item.id}}" bindtap="{{item.qualified?'payBalance':'startHero'}}" disabled="{{hunting.eligibleCount<100||saveError||mood.energy<=0}}">{{item.qualified?'支付1200尾款':'参加考核 · 300金币'}}</button></view></view>
 </block>
 <block wx:else>
  <view class="subtitle">{{targetName}} · {{active.kind==='hero_trial'?'主角考核':'精灵收服'}}</view>
  <hunting-scene600 id="hunt-stage" target-id="{{active.target}}" image="{{targetImage}}" ball="{{ballImage}}" hero-image="{{heroImage}}" biome="{{biome}}" action="{{sceneAction}}" reduced-motion="{{settings.reduced_motion}}" bind:ready="sceneReady"/>
  <view wx:if="{{loading}}" class="card">正在准备猎场，题目显示后才开始计时。</view>
  <block wx:elif="{{question}}">
   <view wx:if="{{active.phase==='ready_to_throw'}}" class="card"><view class="subtitle">答题挑战通过！</view><view class="muted">投出圆宝球，看看新伙伴是否愿意同行。</view><button class="primary" bindtap="throwBall" disabled="{{saveError||throwing}}">{{throwing?'圆宝球飞出中…':'投出圆宝球'}}</button></view>
   <view wx:else class="card"><view class="row"><text>第 {{active.index+1}} / {{active.total}} 题</text><text>{{presenting?'大招演出':timeText||'准备计时'}}</text></view><view class="muted">通过线 {{passPercent}}% · 当前答对{{correct}}题</view><study-text content="{{question.stem}}" theme="{{theme}}"/><question-diagram600 wx:if="{{question.diagram_id}}" diagram-id="{{question.diagram_id}}" bind:diagramstatus="onDiagramStatus"/><view wx:for="{{options}}" wx:key="key" class="option {{item.selected?'selected':''}} {{item.state}}" data-key="{{item.key}}" bindtap="select"><text class="option-key">{{item.key}}</text><text>{{item.text}}</text></view><button wx:if="{{!rec}}" class="primary" bindtap="submit" disabled="{{!selected.length||saveError||presenting||!targetReady||(question.diagram_id&&!diagramReady)}}">提交答案</button><view wx:else><view class="subtitle">{{rec.correct?'答对了！':'记住这一题，下次再攻克'}}</view><view>正确答案：{{question.answer}}</view><study-text content="{{explanation}}" theme="{{theme}}"/><button class="primary" bindtap="next" disabled="{{saveError}}">下一题</button></view></view>
  </block>
  <button class="secondary" bindtap="abandon" disabled="{{saveError}}">主动放弃本次挑战</button>
 </block>
</view>
