<view class="shell {{theme==='dark'?'dark':''}}">
  <view wx:if="{{artError}}" class="save-error">小镇图片暂未加载<button bindtap="retryArt">重试图片加载</button></view><view wx:if="{{saveError||loadError}}" class="save-error">{{loadError||'存档尚未写入成功，请重试保存。'}}<button wx:if="{{saveError||loadError}}" bindtap="retrySave">重试保存或读取</button></view>
  <view class="row top"><view><view class="eyebrow">XIAOYUAN · ADVENTURE</view><view class="title">小圆冒险世界</view></view><button class="theme-button" bindtap="toggleTheme">{{theme==='dark'?'☀':'☾'}}</button></view>
  <view class="row profile"><view class="avatar"><cat-actor skin="{{g.skin||'xiaoyuan'}}" companion="{{g.finance_expansion.companion||''}}" outfit="{{g.outfit||''}}" xp="{{g.equipment.xp||''}}" coins="{{g.equipment.coins||''}}" wonder="{{g.equipment.wonder||''}}"/></view><view class="profile-info" data-screen="growth" bindtap="nav"><view class="subtitle">Lv.{{stats.level}} {{g.title?g.title==='title_common'?'初行探险家':g.title==='title_rare'?'知识守护者':'星海征服者':'知识冒险者'}}</view><view class="xp-track"><view class="xp-bar" style="width:{{xpProgress}}%"/></view></view><view class="wallet">✦ {{g.coins}}<view class="muted">金币</view></view></view>
  <block wx:if="{{screen==='home'}}">
    <view class="scene forest"><view class="cloud"/><view class="mountain"/><view class="hero-cat"><cat-actor skin="{{g.skin||'xiaoyuan'}}" companion="{{g.finance_expansion.companion||''}}" pose="happy" outfit="{{g.outfit||''}}" xp="{{g.equipment.xp||''}}" coins="{{g.equipment.coins||''}}" wonder="{{g.equipment.wonder||''}}"/></view><view class="welcome"><view class="eyebrow">新的冒险，喵！</view><view class="title"><view>每做一道题，</view><view>就向前一步。</view></view><view class="muted">70% 解锁下一关
90% 高质量通关</view></view></view>
    <view class="worlds"><view wx:for="{{worlds}}" wx:key="id" class="world-card {{item.selected?'selected':''}}" data-id="{{item.id}}" bindtap="chooseWorld"><view class="world-icon">{{item.id==='accounting'?'📘':item.id==='finance'?'📊':'⚖'}}</view><view class="subtitle">{{item.name}}</view><view class="muted">{{item.cleared}} / {{item.total}} 关 · {{item.stars}} 星</view></view></view>
    <view wx:if="{{friend}}" class="card"><view class="subtitle">{{friend.name}} · {{friend.role}}</view><view>{{friend.message}}</view><button class="secondary" data-utility="{{friend.utility}}" bindtap="utility">{{friend.utility==='formulas'?'一起打开公式图鉴':friend.utility==='town'?'看看经营委托':'打开复习清单'}}</button></view><view class="row"><button class="secondary" bindtap="openTown">星光经营小镇</button><button class="secondary" bindtap="openFormulas">公式图鉴</button></view><button class="primary" bindtap="continueAdventure">继续{{world.name}}冒险 →</button><button wx:if="{{hasActive}}" class="secondary resume" bindtap="resume">恢复未完成挑战</button>
    <view class="next-growth" data-screen="growth" bindtap="nav"><view class="next-growth-symbol">✧</view><view class="next-growth-copy"><view class="subtitle">{{nextSkill?'下一项技能 · '+nextSkill.name:'小圆的魔法手册'}}</view><view class="muted">{{nextSkill?'Lv.'+nextSkill.level+' 解锁 · 还差 '+nextSkill.xpRemaining+' 经验':'技能、奇物、换装，陪你探索更远'}}</view></view><text class="wish-arrow">›</text></view>
    <view class="spacer"/><view class="row section-heading"><view class="subtitle">冒险足迹</view><text class="muted">六种地图等你点亮</text></view>
    <view class="biomes"><view class="biome" wx:for="{{['森林','海岛','雪山','遗迹','天空','星空']}}" wx:key="*this"><text>{{['🌿','🏝','❄','🏛','☁','✧'][index]}}</text><view>{{item}}</view></view></view>
    <view class="card row"><view><view class="subtitle">无尽远征</view><view class="muted">三科通关后，优先挑战错题与薄弱点</view></view><button class="secondary compact" disabled="{{!expeditionOpen}}" bindtap="expedition">{{expeditionOpen?'出发':'待解锁'}}</button></view>
  </block>
  <block wx:elif="{{screen==='map'}}">
    <view class="row"><view class="subtitle">{{world.name}} · 地图</view><text class="muted">{{stats.cleared}} / {{stats.total}} 关</text></view>
    <scroll-view class="chapter-scroll" scroll-x enhanced><view class="chapter-tabs"><view wx:for="{{chapters}}" wx:key="id" class="chapter-tab {{chapterIndex===index?'selected':''}} {{!item.open?'locked':''}}" data-index="{{index}}" bindtap="chooseChapter">{{item.open?item.completed?'✓':'':'🔒'}} {{item.number}}章</view></view></scroll-view>
    <view class="scene {{chapter.biome}}"><view class="cloud"/><view class="mountain"/><view class="hero-cat"><cat-actor skin="{{g.skin||'xiaoyuan'}}" companion="{{g.finance_expansion.companion||''}}" pose="walk" outfit="{{g.outfit||''}}" xp="{{g.equipment.xp||''}}" coins="{{g.equipment.coins||''}}" wonder="{{g.equipment.wonder||''}}"/></view><view class="scene-label">{{chapter.biomeName}}</view><view class="map-caption"><view class="subtitle">{{chapter.title}}</view><view>击败章末 Boss，下一张地图点亮</view></view></view>
    <view class="route"><view wx:for="{{stages}}" wx:key="id" class="stage {{item.position}} {{!item.open?'locked':''}} {{item.passed?'passed':''}}" data-id="{{item.id}}" bindtap="play"><view class="stage-circle">{{item.open?item.kind==='boss'?'👾':index+1:'🔒'}}</view><view class="stage-copy"><view class="subtitle">{{item.name}}</view><view class="muted">{{item.total}} 题 · {{item.kind==='boss'?'首次击败有宝箱':'70% 通关'}}</view><view class="stars">{{item.stars}} <text class="quality" wx:if="{{item.quality}}">高质量</text></view></view></view></view>
  </block>
  <block wx:elif="{{screen==='bag'}}"><include src="../../templates/bag.wxml"/></block>
  <block wx:elif="{{screen==='growth'}}"><include src="../../templates/growth.wxml"/></block>
  <block wx:elif="{{screen==='town'}}"><include src="../../templates/finance.wxml"/></block><block wx:elif="{{screen==='formulas'}}"><include src="../../templates/formulas.wxml"/></block><block wx:elif="{{screen==='tools'}}"><view class="card"><button class="secondary" bindtap="openTown">返回小镇</button><block wx:if="{{tool==='scratch'}}"><view class="subtitle">计算草稿</view><textarea class="town-scratch" auto-height maxlength="-1" value="{{finance.state.tools.scratch}}" bindinput="scratch" placeholder="记录公式、计算与单位…"/></block><block wx:else><view class="subtitle">25分钟专注时光</view><view class="focus-clock">{{focusText}}</view><view wx:if="{{focusStarted&&!focusRemaining}}">专注完成，休息一下吧！</view><button class="primary" bindtap="startFocus">{{focusStarted?'重新计时':'开始专注'}}</button><button wx:if="{{focusStarted}}" class="secondary" bindtap="stopFocus">结束计时</button></block></view></block><block wx:elif="{{screen==='study'}}">
    <view class="card"><button class="secondary" bindtap="rescue">精灵错题救援 · {{rescueCount}}题</button><view class="subtitle">自由刷题与复习</view><view class="muted">当前：{{world.name}}。可在冒险首页切换科目。</view><view class="spacer"/><picker range="{{bookNames}}" value="{{bookIndex}}" bindchange="selectBook"><view class="filter">教材 · {{bookNames[bookIndex]}} ⌄</view></picker><picker range="{{practiceChapters}}" value="{{practiceChapterIndex}}" bindchange="selectPracticeChapter"><view class="filter">章节 · {{practiceChapters[practiceChapterIndex]}} ⌄</view></picker><picker range="{{types}}" value="{{typeIndex}}" bindchange="selectType"><view class="filter">题型 · {{types[typeIndex]}} ⌄</view></picker><button class="primary" data-mode="all" bindtap="practice">开始自由刷题</button><view class="spacer"/><view class="row"><button class="secondary" data-mode="wrong" bindtap="practice">错题本 · {{learning.wrong}}</button><button class="secondary" data-mode="favorites" bindtap="practice">收藏夹 · {{learning.favorites}}</button></view><button wx:if="{{hasPractice}}" class="secondary resume" bindtap="resumePractice">继续未完成的自由刷题</button></view>
    <view class="card"><view class="subtitle">手机学习记录</view><view class="learning-grid"><view><view class="number">{{learning.answered}}</view><text class="muted">已作答 / {{learning.total}}</text></view><view><view class="number">{{learning.rate}}%</view><text class="muted">最近成绩正确率</text></view></view><view class="muted">冒险挑战独立计分，作答同时更新错题和统计。</view></view>
    <view class="card"><view class="subtitle">存档备份</view><view class="muted">进度保存在当前手机。导出备份后，可从微信聊天中的备份文件恢复。电脑与手机尚未自动同步。</view><view class="spacer"/><view class="row"><button class="secondary" bindtap="exportBackup">导出备份</button><button class="secondary" bindtap="importBackup">恢复备份</button></view></view>
  </block>
  <view class="bottom-nav"><view class="{{screen==='home'?'active':''}}" data-screen="home" bindtap="nav"><view>⌂</view>冒险</view><view class="{{screen==='map'?'active':''}}" data-screen="map" bindtap="nav"><view>♧</view>地图</view><view class="{{screen==='bag'?'active':''}}" data-screen="bag" bindtap="nav"><view>◇</view>背包</view><view class="{{screen==='growth'?'active':''}}" data-screen="growth" bindtap="nav"><view>✧</view>成长</view><view class="{{screen==='study'?'active':''}}" data-screen="study" bindtap="nav"><view>▤</view>复习</view></view>
  <include src="../../templates/item_detail.wxml"/>
</view>
