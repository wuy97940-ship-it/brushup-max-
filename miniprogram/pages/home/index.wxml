<view wx:if="{{upgradePending}}" class="shell upgrade610">
  <view class="release610-badge">6.1 · 新的冒险</view><view class="title">欢迎回来，小圆在等你</view>
  <view class="muted release610-intro">更清爽的主城，完整的篇章地图。先选好存档，再继续学习。</view>
  <view class="card"><view class="subtitle">这次更新</view><view class="release610-line">主城、地图和比武场，各有自己的入口</view><view class="release610-line">篇章地图可以预览，通关后逐步解锁</view><view class="release610-line">伙伴引导随时跳过，也能从“我的”重看</view><view class="release610-line">重新开始前先备份，旧进度随时可恢复</view></view>
  <view wx:if="{{upgradeInfo.loadError||save610Error}}" class="save-error">{{upgradeInfo.loadError||save610Error}}</view>
  <block wx:if="{{upgradeInfo.waitingChoice}}"><view class="card">上次存档操作尚未完成。重试会接着同一次操作进行，不会重复建立新局。</view><button class="primary" bindtap="retry610">重试存档操作</button><button class="secondary resume" bindtap="cancel610">取消待完成操作</button></block>
  <block wx:else><button wx:if="{{upgradeInfo.hasLocal&&!upgradeInfo.loadError}}" class="primary" bindtap="continue610">继续原存档</button><button wx:if="{{!upgradeInfo.loadError}}" class="{{upgradeInfo.hasLocal?'secondary resume':'primary'}}" bindtap="startNew610">{{upgradeInfo.hasLocal?'备份后重新开始':'开始冒险'}}</button></block>
  <view class="card"><view class="muted">{{cloud610.text}}</view><button wx:if="{{cloud610.hasCloud}}" class="secondary resume" bindtap="continueCloud610" disabled="{{cloud610.busy}}">继续当前微信的云存档</button><button wx:elif="{{!cloud610.known}}" class="text610-button" bindtap="checkCloud610">重试检查云档</button></view><view class="muted release610-foot">{{upgradeInfo.hasLocal?'未作出选择前，不会改动原进度。':'学习进度会保存在本机。'}}电脑和手机分别保存进度。</view>
</view>
<view wx:else class="shell {{theme==='dark'?'dark':''}}">
  <view wx:if="{{artError}}" class="save-error">小镇图片暂未加载<button bindtap="retryArt">重试图片加载</button></view><view wx:if="{{saveError||loadError}}" class="save-error">{{loadError||'存档尚未写入成功，请重试保存。'}}<button wx:if="{{saveError||loadError}}" bindtap="retrySave">重试保存或读取</button></view>
  <view class="row top"><view><view class="eyebrow">XIAOYUAN · ADVENTURE</view><view class="title">小圆冒险世界</view></view><button class="theme-button" bindtap="toggleTheme">{{theme==='dark'?'☀':'☾'}}</button></view>
  <block wx:if="{{screen==='home'||screen==='bag'||screen==='growth'}}">
  <view class="row profile"><view class="avatar"><cat-actor skin="{{g.skin||'xiaoyuan'}}" companion="{{g.finance_expansion.companion||''}}" companions="{{g.companions||[]}}" outfit="{{g.outfit||''}}" xp="{{g.equipment.xp||''}}" coins="{{g.equipment.coins||''}}" wonder="{{g.equipment.wonder||''}}"/></view><view class="profile-info" data-screen="growth" bindtap="nav"><view class="subtitle">Lv.{{stats.level}} {{g.title?g.title==='title_common'?'初行探险家':g.title==='title_rare'?'知识守护者':'星海征服者':'知识冒险者'}}</view><view class="xp-track"><view class="xp-bar" style="width:{{xpProgress}}%"/></view></view><view class="wallet">✦ {{g.coins}}<view class="muted">金币</view></view></view>
  <include src="../../templates/resources600.wxml"/>
  </block>
  <view wx:if="{{modern&&g.starter_claimed&&mood.energy<=0}}" class="card"><view class="subtitle">伙伴休眠了</view><view class="muted">可在商店购买600金币的还魂丹，恢复体力继续；也可以重新开始整个游戏。</view><button class="secondary" bindtap="openMood">购买或使用还魂丹</button><button class="secondary" bindtap="restartGame">重新开始整个游戏</button></view>
  <block wx:if="{{screen==='home'}}">
    <view class="scene forest home610-scene"><view class="cloud"/><view class="mountain"/><view class="hero-cat"><cat-actor skin="{{g.skin||'xiaoyuan'}}" companion="{{g.finance_expansion.companion||''}}" companions="{{g.companions||[]}}" pose="happy" outfit="{{g.outfit||''}}" xp="{{g.equipment.xp||''}}" coins="{{g.equipment.coins||''}}" wonder="{{g.equipment.wonder||''}}"/></view><view class="welcome"><view class="eyebrow">今天也向前一步</view><view class="title">{{world.name}}冒险</view><view class="muted">已点亮 {{worldStats.cleared}} / {{worldStats.total}} 关</view></view></view>
    <view class="worlds {{worlds.length===4?'four-worlds':''}}"><view wx:for="{{worlds}}" wx:key="id" class="world-card {{item.selected?'selected':''}}" data-id="{{item.id}}" bindtap="chooseWorld"><view class="world-icon">{{item.id==='accounting'?'📘':item.id==='finance'?'📊':item.id==='audit'?'🔎':'⚖'}}</view><view class="subtitle">{{item.name}}</view><view class="muted">{{item.cleared}} / {{item.total}} 关 · {{item.stars}} 星</view></view></view>
    <button wx:if="{{hasActive}}" class="primary" bindtap="resume">继续未完成的挑战 →</button><button wx:else class="primary" bindtap="continueAdventure">继续主线 →</button>
    <view class="home610-links"><button class="secondary" data-screen="map" bindtap="nav">篇章地图</button><button class="secondary" data-screen="study" bindtap="nav">刷题与复习</button></view>
    <view class="card daily610"><view class="subtitle">今日学习 {{daily600.count}} / {{daily600.target}}</view><view class="muted">{{daily600.qualified?'今天的坚持已经记下啦。':'每一道认真作答，都在积累成长。'}}</view></view>
    <button class="text610-button" bindtap="openGuide">让伙伴带我熟悉一下</button>
  </block>
  <block wx:elif="{{screen==='map'}}">
    <view class="world610-picker"><view wx:for="{{worlds}}" wx:key="id" class="{{item.selected?'selected':''}}" data-id="{{item.id}}" bindtap="chooseWorld">{{item.name}}</view></view>
    <view class="row"><view class="subtitle">{{world.name}} · 地图</view><text class="muted">{{worldStats.cleared}} / {{worldStats.total}} 关</text></view>
    <view class="chapter610-grid"><view wx:for="{{chapters}}" wx:key="id" class="chapter610 {{chapterIndex===index?'selected':''}}" data-index="{{index}}" bindtap="chooseChapter"><text>{{item.completed?'✓':item.open?'◇':'🔒'}} 第{{item.number}}章</text><view class="muted">{{item.title}}</view></view></view>
    <view wx:if="{{!chapter.open}}" class="notice610">正在预览此篇章。完成前面的关卡后，即可来这里冒险。</view>
    <view class="scene {{chapter.biome}}"><view class="cloud"/><view class="mountain"/><view class="hero-cat"><cat-actor skin="{{g.skin||'xiaoyuan'}}" companion="{{g.finance_expansion.companion||''}}" companions="{{g.companions||[]}}" pose="walk" outfit="{{g.outfit||''}}" xp="{{g.equipment.xp||''}}" coins="{{g.equipment.coins||''}}" wonder="{{g.equipment.wonder||''}}"/></view><view class="scene-label">{{chapter.biomeName}}</view><view class="map-caption"><view class="subtitle">{{chapter.title}}</view><view>击败章末 Boss，下一张地图点亮</view></view></view>
    <view class="route"><view wx:for="{{stages}}" wx:key="id" class="stage {{item.position}} {{!item.open?'locked':''}} {{item.passed?'passed':''}}" data-id="{{item.id}}" bindtap="play"><view class="stage-circle">{{item.open?item.kind==='boss'?'👾':index+1:'🔒'}}</view><view class="stage-copy"><view class="subtitle">{{item.name}}</view><view class="muted">{{item.total}} 题 · {{item.kind==='boss'?'首次击败有宝箱':'80% 通关'}}</view><view class="stars">{{item.stars}} <text class="quality" wx:if="{{item.quality}}">高质量</text></view></view></view></view>
  </block>
  <block wx:elif="{{screen==='arena'}}"><view class="card"><view class="subtitle">知识比武场</view><view class="muted">经核验的重难点客观题，独立挑战，原有主线进度不变。</view><view class="world610-picker"><view wx:for="{{worlds}}" wx:key="id" class="{{item.selected?'selected':''}}" data-id="{{item.id}}" bindtap="chooseWorld">{{item.name}}</view></view><picker range="{{['5题','10题','20题']}}" value="{{arenaCountIndex}}" bindchange="arenaCount610"><view class="filter">本场题量 · {{['5题','10题','20题'][arenaCountIndex]}} ⌄</view></picker><picker range="{{['入门 · 60%','标准 · 80%','进阶 · 90%']}}" value="{{arenaRateIndex}}" bindchange="arenaRate610"><view class="filter">对手目标 · {{['入门 · 60%','标准 · 80%','进阶 · 90%'][arenaRateIndex]}} ⌄</view></picker><view class="row"><text class="muted">优先练习错题</text><switch checked="{{arenaWeak}}" bindchange="arenaWeak610" color="#2066d5"/></view><button class="primary" data-mode="arena" bindtap="startArena610">普通比武 · 禁用技能</button><button class="secondary resume" data-mode="arena_skills" bindtap="startArena610">技能比武</button><button wx:if="{{hasArena610}}" class="secondary resume" bindtap="resumeArena610">继续未完成的比武</button></view><button class="secondary" bindtap="openHunting">精灵猎场与主角考核</button></block>
  <block wx:elif="{{screen==='me'}}">
    <view class="card menu610"><view class="subtitle">我的冒险</view><view class="home610-links"><button class="secondary" data-screen="bag" bindtap="nav">背包与商店</button><button class="secondary" data-screen="growth" bindtap="nav">成长与技能</button><button class="secondary" bindtap="openTown">经营小镇</button><button class="secondary" bindtap="openFormulas">公式图鉴</button><button class="secondary" data-screen="study" bindtap="nav">刷题与复习</button><button class="secondary" bindtap="openHunting">精灵猎场</button></view></view>
    <view class="card"><view class="subtitle">休息与补给</view><view class="home610-links"><button class="secondary" bindtap="openMood">玩具与出游券</button><button class="secondary" bindtap="restMood" disabled="{{modern&&restStarted&&restRemaining>0}}">{{modern&&restStarted?restRemaining>0?'休息中 '+restText:'领取休息恢复':'免费休息10分钟'}}</button></view><view wx:if="{{friend}}" class="muted">{{friend.name}}：{{friend.message}}</view><button wx:if="{{friend}}" class="text610-button" data-utility="{{friend.utility}}" bindtap="utility">看看伙伴的建议</button><button class="secondary" disabled="{{!expeditionOpen}}" bindtap="expedition">{{expeditionOpen?'无尽远征 · 出发':'无尽远征 · 全科通关后解锁'}}</button></view>
    <view class="card"><view class="subtitle">云存档</view><view class="muted">{{cloud610.text||'尚未连接，当前进度正常保存在本机。'}}</view><button class="secondary resume" bindtap="syncCloud610">同步与管理</button></view>
    <view class="card"><view class="subtitle">本机存档</view><view class="muted">恢复前会保留当前进度。电脑和手机分别保存。</view><view class="home610-links"><button class="secondary" bindtap="exportBackup">导出文件备份</button><button class="secondary" bindtap="importBackup">从文件恢复</button></view><view wx:for="{{backups610}}" wx:key="key" class="backup610-row"><view><view>{{item.label}}备份</view><view class="muted">{{item.dateText}}</view></view><button class="secondary compact" data-key="{{item.key}}" bindtap="restore610">恢复</button></view><button class="text610-button" bindtap="startNew610">备份后重新开始</button></view>
    <view class="card menu610"><button wx:if="{{cloud610.admin}}" class="secondary" bindtap="openAdmin610">管理员 · 学习回访概览</button><button class="secondary" bindtap="openGroup610">小圆爱刷题交流群</button><button class="secondary" bindtap="openGuide">重看伙伴引导</button><button class="secondary" bindtap="openUpdate">{{update610.text||'当前版本 6.1.1'}}</button></view>
  </block>
  <block wx:elif="{{screen==='bag'}}"><include src="../../templates/bag.wxml"/></block>
  <block wx:elif="{{screen==='growth'}}"><include src="../../templates/growth.wxml"/></block>
  <block wx:elif="{{screen==='town'}}"><include src="../../templates/finance.wxml"/></block><block wx:elif="{{screen==='formulas'}}"><include src="../../templates/formulas.wxml"/></block><block wx:elif="{{screen==='tools'}}"><view class="card"><button class="secondary" bindtap="openTown">返回小镇</button><block wx:if="{{tool==='scratch'}}"><view class="subtitle">计算草稿</view><textarea class="town-scratch" auto-height maxlength="-1" value="{{finance.state.tools.scratch}}" bindinput="scratch" placeholder="记录公式、计算与单位…"/></block><block wx:else><view class="subtitle">25分钟专注时光</view><view class="focus-clock">{{focusText}}</view><view wx:if="{{focusStarted&&!focusRemaining}}">专注完成，休息一下吧！</view><button class="primary" bindtap="startFocus">{{focusStarted?'重新计时':'开始专注'}}</button><button wx:if="{{focusStarted}}" class="secondary" bindtap="stopFocus">结束计时</button></block></view></block><block wx:elif="{{screen==='study'}}">
    <view class="card"><button class="secondary" bindtap="rescue">精灵错题救援 · {{rescueCount}}题</button><view class="subtitle">自由刷题与复习</view><view class="muted">当前：{{world.name}}。可在冒险首页切换科目。</view><view class="spacer"/><picker range="{{bookNames}}" value="{{bookIndex}}" bindchange="selectBook"><view class="filter">教材 · {{bookNames[bookIndex]}} ⌄</view></picker><picker range="{{practiceChapters}}" value="{{practiceChapterIndex}}" bindchange="selectPracticeChapter"><view class="filter">章节 · {{practiceChapters[practiceChapterIndex]}} ⌄</view></picker><picker range="{{types}}" value="{{typeIndex}}" bindchange="selectType"><view class="filter">题型 · {{types[typeIndex]}} ⌄</view></picker><button class="primary" data-mode="all" bindtap="practice">开始自由刷题</button><view class="spacer"/><view class="row"><button class="secondary" data-mode="wrong" bindtap="practice">错题本 · {{learning.wrong}}</button><button class="secondary" data-mode="favorites" bindtap="practice">收藏夹 · {{learning.favorites}}</button></view><button wx:if="{{hasPractice}}" class="secondary resume" bindtap="resumePractice">继续未完成的自由刷题</button></view>
    <view class="card"><view class="subtitle">手机学习记录</view><view class="learning-grid"><view><view class="number">{{learning.answered}}</view><text class="muted">已作答 / {{learning.total}}</text></view><view><view class="number">{{learning.rate}}%</view><text class="muted">最近成绩正确率</text></view></view><view class="muted">冒险挑战独立计分，作答同时更新错题和统计。</view></view>
  </block>
  <view class="bottom-nav"><view class="{{screen==='home'?'active':''}}" data-screen="home" bindtap="nav"><view>⌂</view>主城</view><view class="{{screen==='map'?'active':''}}" data-screen="map" bindtap="nav"><view>♧</view>地图</view><view class="{{screen==='arena'?'active':''}}" data-screen="arena" bindtap="nav"><view>⚑</view>比武场</view><view class="{{screen!=='home'&&screen!=='map'&&screen!=='arena'?'active':''}}" data-screen="me" bindtap="nav"><view>◇</view>我的</view></view>
  <include src="../../templates/item_detail.wxml"/>
</view>

<view wx:if="{{moodEffect}}" class="mood-effect-shade" bindtap="closeMoodEffect"><view class="mood-effect" catchtap="noop"><view class="title">{{moodEffect.name}}</view><image src="{{shopDetail.icon}}" mode="aspectFit" wx:if="{{shopDetail.icon}}"/><view>{{moodEffect.resource==='mood'?'心情':moodEffect.resource==='energy'?'体力':'魔法'}} {{moodEffect.before}} → {{moodEffect.after}}</view><view class="muted">实际恢复 {{moodEffect.restored}} · 溢出 {{moodEffect.overflow}}</view><view class="muted">已消耗1个并保存</view><button class="primary" bindtap="closeMoodEffect">知道了</button></view></view>

<view wx:if="{{!upgradePending&&modern&&!g.starter_claimed}}" class="starter600-shade"><view class="starter600-card"><view class="title">新的冒险，从这里开始</view><view class="muted">选择一位免费初始伙伴。初始心情50，魔法在Lv.10解锁。</view><view wx:for="{{starterHeroes}}" wx:key="id" class="starter600-option"><view class="starter600-actor"><cat-actor skin="{{item.id}}" pose="happy"/></view><view><view class="subtitle">{{item.name}}</view><view class="muted">{{item.description}}</view><button class="primary" data-id="{{item.id}}" bindtap="selectStarter" disabled="{{saveError||loadError}}">和{{item.name}}一起出发</button></view></view><button wx:if="{{saveError||loadError}}" class="secondary" bindtap="retrySave">重试保存或读取</button></view></view>
<view wx:if="{{!upgradePending&&g.starter_claimed&&guideStep>=0}}" class="guide610-shade"><view class="guide610-card"><button class="text610-button guide610-close" bindtap="closeGuide">跳过 / 关闭</button><view class="release610-badge">伙伴引导 {{guideStep+1}} / 3</view><view class="title">{{guideStep===0?'主城，接着上次继续':guideStep===1?'地图，看看前方的旅程':'我的，照顾好伙伴与存档'}}</view><view class="guide610-copy">{{guideStep===0?'主城的大按钮会带你继续未完成的挑战。也可以先选想学的科目，再继续主线。':guideStep===1?'四个世界的篇章都能查看。带锁的关卡可以预览，完成前面的挑战后才会解锁。比武场是独立的重难点挑战。':'背包、成长、小镇与复习都在“我的”。备份、恢复、更新和学习群也在这里。需要时可以随时重看引导。'}}</view><button class="primary" bindtap="nextGuide">{{guideStep===2?'开始探索':'下一步'}}</button></view></view>
<view wx:if="{{group610}}" class="guide610-shade"><view class="guide610-card"><view class="title">{{group610.name}}</view><view class="muted">一起交流刷题心得，自愿加入，入群需管理员确认。</view><image class="group610-qr" src="{{group610.image}}" mode="aspectFit" show-menu-by-longpress/><view class="muted">二维码有效期至 {{group610.dateText}}；若无法识别，请稍后刷新入口。</view><button class="secondary resume" bindtap="closeGroup610">关闭</button></view></view>

<view wx:if="{{metrics610}}" class="guide610-shade"><view class="guide610-card"><view class="title">最近7天学习回访</view><view class="muted">仅汇总已启用云存档用户的应用回报，不显示个人作答或联系方式。</view><view wx:for="{{metrics610}}" wx:key="day" class="backup610-row"><view><view>{{item.day}}</view><view class="muted">访问 {{item.visits}} · 回访 {{item.returning}}</view><view class="muted">学习 {{item.studied}} · 通关 {{item.cleared}}</view></view></view><button class="secondary resume" bindtap="closeAdmin610">关闭</button></view></view>
