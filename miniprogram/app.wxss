page{background:#f1f6ff;color:#173052;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}view,text,button,input,textarea{box-sizing:border-box}button{margin:0;font-size:28rpx;font-weight:600;line-height:1.5;border-radius:24rpx}button::after{border:0}button[disabled]{opacity:.45}button.primary{background:#236bdf;color:#fff;padding:25rpx 30rpx;box-shadow:0 10rpx 24rpx #236bdf24}button.secondary{background:#e8f0ff;color:#2365c3;padding:21rpx 24rpx}.shell{padding:30rpx 28rpx 170rpx;min-height:100vh}.dark{background:#101e33;color:#e5eeff}.card{background:#fff;border-radius:32rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 10rpx 36rpx #315b9610}.dark .card{background:#1b2d46}.muted{color:#75849a;font-size:24rpx;line-height:1.65}.dark .muted{color:#acbad0}.title{font-size:40rpx;font-weight:800;line-height:1.4}.subtitle{font-size:30rpx;font-weight:700}.eyebrow{font-size:22rpx;letter-spacing:3rpx;color:#4d83c5;font-weight:700}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.stack{display:flex;flex-direction:column;gap:16rpx}.pill{border-radius:100rpx;background:#e8f1ff;color:#2462b7;padding:8rpx 18rpx;font-size:22rpx}.dark .pill{background:#2c4365;color:#bad5ff}.save-error{background:#fff1ef;border:2rpx solid #fbb5ab;border-radius:20rpx;padding:20rpx;margin-bottom:20rpx;color:#a43325}.save-error button{background:#ffe0d9;color:#a43325;padding:16rpx;margin-top:12rpx}.scene{position:relative;overflow:hidden;border-radius:30rpx;height:350rpx;background:linear-gradient(180deg,#c9eaff,#eaf8ff 60%,#c5e7bf);margin:18rpx 0}.scene.island{background:linear-gradient(180deg,#bfedff,#e8faff 50%,#62cddd 50%,#87e2ed 84%,#f4e4ae 84%)}.scene.snow{background:linear-gradient(180deg,#cddcff,#f0f8ff 65%,#dae8fa)}.scene.ruins{background:linear-gradient(180deg,#dee4ee,#fbefda 65%,#d2c6a9)}.scene.sky{background:linear-gradient(180deg,#ccd5ff,#efefff)}.scene.stars{background:radial-gradient(ellipse at top,#6d5aac,#171b4c 70%)}.dark .scene.forest{background:linear-gradient(180deg,#153350,#254b4c 60%,#244436)}.cloud{position:absolute;top:55rpx;left:35rpx;width:150rpx;height:38rpx;border-radius:100rpx;background:#ffffffa0;box-shadow:100rpx -20rpx 0 2rpx #ffffff80,320rpx 40rpx 0 8rpx #ffffff70}.mountain{position:absolute;bottom:30rpx;right:-50rpx;width:320rpx;height:280rpx;transform:rotate(45deg);border-radius:35rpx;background:#88b5a044;box-shadow:-190rpx 200rpx 0 #77b49333}.snow .mountain{background:#b9cae8;box-shadow:-160rpx 170rpx 0 #e9f3ff}.ruins .mountain{border-radius:12rpx;transform:rotate(0);width:95rpx;height:160rpx;right:80rpx;background:#b8a782;box-shadow:160rpx 30rpx 0 #c9b591,-150rpx 65rpx 0 #b5ac98}.sky .mountain{border-radius:100%;transform:none;height:50rpx;width:360rpx;bottom:55rpx;background:#fff;box-shadow:-100rpx -100rpx 0 #ffffffa0}.stars .cloud{background:#e7d3ff;top:30rpx;width:7rpx;height:7rpx;box-shadow:75rpx 70rpx 0 #fff,240rpx 20rpx 0 #fff,530rpx 120rpx 0 2rpx #eee,180rpx 190rpx 0 1rpx #bbd3ff,390rpx 55rpx 0 1rpx #fff}.stars .mountain{background:#6b52a444;box-shadow:-190rpx 200rpx 0 #48336f55}.hero-cat{position:absolute;bottom:0;left:28rpx;width:285rpx;height:285rpx;animation:bob 3.2s ease-in-out infinite}.scene-label{position:absolute;right:24rpx;top:22rpx;background:#ffffffba;color:#245383;border-radius:100rpx;padding:8rpx 20rpx;font-size:23rpx}.status-chip{font-size:22rpx;padding:6rpx 14rpx;border-radius:14rpx;background:#e9f7ed;color:#247940}.rarity-common{color:#64748b}.rarity-rare{color:#3373df}.rarity-epic{color:#8855cc}.empty{padding:60rpx 20rpx;text-align:center;color:#8291a8}.spacer{height:22rpx}@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-10rpx)}}
