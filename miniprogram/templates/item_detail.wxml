<view wx:if="{{shopDetail}}" class="detail-shade" bindtap="closeItem"><view class="detail-sheet {{theme==='dark'?'dark':''}}" catchtap="noop"><view class="row"><view class="eyebrow">{{shopDetail.wearable?'试穿小镜子':shopDetail.isSkill?'魔法卷轴':'旅行藏品'}}</view><button class="detail-close" bindtap="closeItem">×</button></view><scroll-view scroll-y class="detail-scroll"><view class="detail-art rarity-bg-{{shopDetail.rarity}}"><view wx:if="{{shopDetail.wearable&&!shopDetail.title}}" class="detail-actor"><cat-actor skin="{{shopDetail.preview.skin}}" pose="idle" outfit="{{shopDetail.preview.outfit}}" xp="{{shopDetail.preview.xp}}" coins="{{shopDetail.preview.coins}}" wonder="{{shopDetail.preview.wonder}}"/></view><view wx:elif="{{shopDetail.isSkill}}" class="skill-book large-book" style="background:{{shopDetail.color}}"><view class="book-spine"/><text>{{shopDetail.glyph}}</text></view><image wx:elif="{{shopDetail.icon}}" src="{{shopDetail.icon}}" class="detail-image" mode="aspectFit"/><view wx:else class="title-medal"><text>✦</text></view><text wx:if="{{shopDetail.wearable}}" class="preview-caption">{{shopDetail.owned?'搭配预览':'先看看穿上的样子'}}</text></view><view class="title detail-name">{{shopDetail.name}}</view><view class="rarity-{{shopDetail.rarity}}">{{shopDetail.rarityName}} · {{shopDetail.categoryName}}</view><view class="detail-effect">{{shopDetail.effect}}</view><view class="muted detail-story">{{shopDetail.story}}</view><view class="detail-balance">{{shopDetail.owned?'已经在你的背包里':shopDetail.price+' 金币 · 现有 '+g.coins+(shopDetail.remaining?' · 还差 '+shopDetail.remaining:'')}}</view><view class="muted" wx:if="{{!shopDetail.unlocked}}">{{shopDetail.unlockText}}</view><view class="detail-actions"><button wx:if="{{shopDetail.owned&&shopDetail.wearable}}" class="primary" data-id="{{shopDetail.id}}" bindtap="itemAction">{{shopDetail.isCharacter?shopDetail.equipped?'当前伙伴':'选择这个伙伴':shopDetail.equipped?'卸下装备':'穿戴出发'}}</button><button wx:elif="{{!shopDetail.owned}}" class="primary" data-id="{{shopDetail.id}}" bindtap="itemAction" disabled="{{!shopDetail.canBuy}}">{{shopDetail.isSkill?'兑换卷轴 · 补充一次':'兑换这件宝贝'}}</button><button wx:else class="secondary" disabled>已珍藏</button><button wx:if="{{!shopDetail.owned&&!shopDetail.isSkill}}" class="secondary" data-id="{{shopDetail.id}}" bindtap="setWish">{{g.wishlist===shopDetail.id?'已设为心愿目标':'设为攒钱心愿'}}</button></view><button wx:if="{{!shopDetail.owned&&shopDetail.remaining}}" class="earn-coins" data-screen="home" bindtap="nav">去闯关赚金币 →</button><view class="detail-foot">{{shopDetail.wearable?'可自由搭配；效果在下场挑战开始时固定。':'金币和奖励来自学习通关。'}}</view></scroll-view></view></view>
