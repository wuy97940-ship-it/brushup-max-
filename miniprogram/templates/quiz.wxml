<view class="shell quiz-shell {{theme==='dark'?'dark':''}}">
  <view wx:if="{{saveError||loadError}}" class="save-error">{{loadError||'存档尚未写入成功，奖励尚未领取。'}}<button wx:if="{{saveError}}" bindtap="retrySave">重试保存</button></view>
  <view class="row"><view><view class="eyebrow">{{practice?'STUDY TIME':level.kind==='boss'?'BOSS CHALLENGE':'EXPLORATION'}}</view><view class="subtitle">{{level.chapter_title}}</view><view class="muted">{{level.name}} · {{total}} 题</view></view><button class="secondary small-button" bindtap="home">地图</button></view>
  <view class="scene battle {{level.biome}} {{animation}}"><view class="cloud"/><view class="mountain"/><view class="hero-cat"><cat-actor skin="{{g.skin||'xiaoyuan'}}" companion="{{g.finance_expansion.companion||''}}" pose="{{pose}}" outfit="{{g.outfit||''}}" xp="{{g.equipment.xp||''}}" coins="{{g.equipment.coins||''}}" wonder="{{g.equipment.wonder||''}}"/></view><view wx:if="{{level.kind==='boss'}}" class="boss"><view class="boss-face">👾</view><view class="boss-title">章节守护者</view><view class="hp-track"><view class="hp-bar" style="width:{{bossHP}}%"/></view></view><view wx:else class="battle-message">{{settled?result.passed?'这份知识，拿下！':'陪你再挑战一次':rec?rec.correct?'答对啦，出击！':'记住它，下次一定！':'认真思考，再出发'}}</view><view wx:if="{{animation==='chest'||animation==='reveal'}}" class="treasure">🎁</view></view>
  <view wx:if="{{activeSkills.length}}" class="challenge-buffs"><text wx:for="{{activeSkills}}" wx:key="*this">✧ {{item}} 已生效</text></view>
  <block wx:if="{{settled}}">
    <view class="card result"><view class="result-stars">{{practice?'✓':result.starText}}</view><view class="title">{{practice?result.quality:result.heading}}</view><view class="score">{{result.correct}} / {{result.total}}<text>正确 · {{result.rate}}%</text></view><view class="pill" wx:if="{{!practice}}">{{result.quality}}{{result.stars===3?' · 三星全对':''}}</view><view wx:if="{{reveal&&result.passed&&!practice}}" class="reward"><view>+{{result.xp}} 经验　+{{result.coins}} 金币</view><view wx:if="{{result.loot}}" class="loot">{{result.lootText}}</view><view wx:if="{{result.growthRewards.length}}" class="surprise-rewards"><view class="subtitle">意外的小惊喜！</view><view wx:for="{{result.growthRewards}}" wx:key="name" class="surprise-item"><image wx:if="{{item.icon}}" src="{{item.icon}}" mode="aspectFit"/><view wx:else class="ink-spark">✧</view><view><view>{{item.label}}</view><view class="muted small">这关的首次惊喜，已经收入背包。</view></view></view></view><view wx:if="{{result.level_after>result.level_before}}" class="level-up">升级啦！Lv.{{result.level_before}} → Lv.{{result.level_after}}<view wx:for="{{result.learnedSkills}}" wx:key="*this">新学会 · {{item}}</view></view><view class="muted" wx:if="{{!result.first_clear}}">本次只补新增星级奖励；首次宝箱资格不会重抽。</view></view><view class="muted" wx:if="{{!result.passed&&!practice}}">完整作答，正确率达到 70% 即可解锁下一关。</view><view wx:if="{{result.assisted}}" class="mercy-note">已消耗一次瞒天过海，以技能通关解锁。真实正确率 {{result.rate}}%，错题保留待复习；90% 高质量仍看实际作答。</view><view wx:if="{{mercy.eligible}}" class="mercy-offer"><view class="subtitle">只差一道题，小圆还有魔法</view><view class="muted">{{skillLevel<3?'Lv.3 学会瞒天过海':'剩余 '+mercy.available+' 次；仅用于普通关与远征'}}</view><button class="skill-use mercy-use" bindtap="useMercy" disabled="{{!mercy.available}}">瞒天过海 · 消耗 1 次继续</button></view><view class="spacer"/><button wx:if="{{result.passed}}" class="primary" disabled="{{!reveal}}" bindtap="nextStage">{{practice?'回到地图':result.stars>=2?'高质量解锁 · 进入下一关':'已解锁 · 进入下一关'}}</button><button class="{{result.passed?'secondary resume':'primary'}}" bindtap="retry">{{result.passed?'重新挑战，争取三星':'立即重新挑战全部题目'}}</button><button class="secondary resume" bindtap="home">保存并返回冒险首页</button></view>
  </block>
  <block wx:else>
    <view class="row question-progress"><text>第 {{index+1}} / {{total}} 题</text><text class="muted">本轮答对 {{correct}} 题</text></view><view class="progress-track"><view class="progress-bar" style="width:{{progress}}%"/></view>
    <view class="card question"><view class="row question-heading"><text class="pill">{{question.type}}</text><button class="favorite" bindtap="favorite">{{favorite?'★ 已收藏':'☆ 收藏'}}</button></view><view class="muted source">{{question.chapter}} · {{question.id}}</view><study-text content="{{question.stem_images_primary?'请阅读教材题图作答，点图可以放大；题目条件、表格和选项以图为准。':question.stem}}" theme="{{theme}}"/><image wx:for="{{question.stem_images}}" wx:key="*this" class="source-diagram" src="{{item}}" mode="widthFix" data-src="{{item}}" bindtap="previewImage"/>
      <block wx:if="{{!subjective}}"><view wx:if="{{multiple}}" class="muted multi-hint">多选题，请选择全部正确选项后提交</view><view wx:for="{{options}}" wx:key="key" class="option {{item.selected?'selected':''}} {{item.state}} {{item.eliminated?'eliminated':''}}" data-key="{{item.key}}" bindtap="select"><view class="option-key">{{item.key}}</view><text class="option-text" user-select>{{question.stem_images_primary?'以原图选项为准':item.text}}</text></view><view wx:if="{{eliminated.length}}" class="hint-note">✧ 灵光一现已排除一个错误选项，剩下的判断交给你。</view><button wx:if="{{canHint}}" class="skill-use hint-use" bindtap="useHint" disabled="{{!hintCharges}}">{{skillLevel<2?'灵光一现 · Lv.2 学会':'灵光一现 · 排除一项（剩余 '+hintCharges+' 次）'}}</button><button wx:if="{{!rec}}" class="primary submit" bindtap="submit" disabled="{{!selected.length}}">提交答案 · 出击</button></block>
      <block wx:elif="{{structured}}"><include src="structured.wxml"/></block><block wx:else><textarea class="subjective-answer" auto-height value="{{draft}}" placeholder="先写下自己的结论和理由，再查看参考答案…" maxlength="-1" disabled="{{!!rec}}" bindinput="input" adjust-position cursor-spacing="100"/><button wx:if="{{!reference}}" class="secondary" bindtap="showReference" disabled="{{!canReference}}">查看参考答案</button><view wx:if="{{reference}}" class="explanation reference"><view class="subtitle">参考答案</view><study-text content="{{question.reference_images_primary?'请对照下方教材参考图，逐步核对自己的答案。':question.answer||question.explanation||'请对照教材进行自评。'}}" theme="{{theme}}"/></view><button wx:if="{{canOutline}}" class="skill-use" bindtap="useOutline" disabled="{{!outlineCharges}}">{{skillLevel<10?'妙笔生花 · Lv.10 学会':'妙笔生花 · 分段复盘（剩余 '+outlineCharges+' 次）'}}</button><view wx:if="{{outlineCards.length}}" class="outline-cards"><view class="subtitle">妙笔生花 · 原答案复盘卡</view><view wx:for="{{outlineCards}}" wx:key="index" class="outline-card"><text class="outline-index">{{index+1}}</text><text user-select>{{item}}</text></view></view><view wx:if="{{reference&&!rec}}" class="self-grade"><button class="primary" data-correct="yes" bindtap="submit">思路正确 · 攻击</button><button class="secondary" data-correct="no" bindtap="submit">还需复习 · 记错题</button></view></block>
      <view wx:if="{{rec}}" class="answer-result {{rec.correct?'correct':'incorrect'}}">{{rec.correct?'✓ 答对了':'记入错题本，下次再攻克'}}<view wx:if="{{!subjective}}">正确答案：{{question.answer}}　你的答案：{{rec.user_answer}}</view></view><view wx:if="{{rec&&question.explanation&&!question.reference_images_primary}}" class="explanation"><view class="subtitle">题目解析</view><study-text content="{{question.explanation}}" theme="{{theme}}"/></view><view wx:if="{{rec||submission||reference}}"><image wx:for="{{question.reference_images}}" wx:key="*this" class="source-diagram" src="{{item}}" mode="widthFix" data-src="{{item}}" bindtap="previewImage"/><include src="analysis.wxml"/></view><view wx:if="{{rec}}" class="muted first-submit">本轮以第一次提交为准，下一轮可以重新挑战。</view>
    </view>
    <view class="quiz-footer"><button class="primary" bindtap="next" disabled="{{!canNext||saveError}}">{{atEnd?practice?'完成复习':'全部完成 · 结算':'下一题 →'}}</button><button class="secondary" bindtap="home">保存并返回</button></view>
  </block>
</view>
