.shop-front{position:relative;overflow:hidden;border-radius:32rpx;border:3rpx solid #bdd7fb;background:linear-gradient(155deg,#eff9ff,#dbe9ff);height:300rpx;margin-bottom:24rpx;box-shadow:0 14rpx 32rpx #2a68ad12}
.awning{position:absolute;top:0;left:0;right:0;height:48rpx;background:repeating-linear-gradient(90deg,#5098e8 0,#5098e8 52rpx,#e9f6ff 52rpx,#e9f6ff 104rpx);border-radius:0 0 22rpx 22rpx;box-shadow:0 5rpx 0 #20529a18}
.shopkeeper{position:absolute;left:4rpx;bottom:0;width:255rpx;height:255rpx}.shop-sign{position:absolute;left:255rpx;right:16rpx;top:74rpx}.shop-label{font-size:24rpx;color:#577db2;font-weight:700}.shop-title{font-size:33rpx;line-height:1.5;font-weight:800;color:#1a3f71;margin:8rpx 0}.shop-talk{font-size:21rpx;line-height:1.6;color:#607da0}.shop-wallet{display:inline-block;margin-top:15rpx;color:#8d6423;background:#fff2cc;border:2rpx solid #ecd28c;padding:7rpx 20rpx;border-radius:100rpx;font-size:24rpx;font-weight:700}.shop-spark{position:absolute;color:#d6ac42;font-size:30rpx}.spark-a{left:45rpx;top:78rpx}.spark-b{right:25rpx;top:48rpx}.shop-heading{margin-bottom:20rpx}
.shop-filter{white-space:nowrap;margin:22rpx 0 26rpx}.shop-filter-row{display:flex;gap:12rpx}.filter-chip{flex-shrink:0;padding:14rpx 23rpx;background:#e4edfc;color:#617a9d;border-radius:100rpx;font-size:24rpx}.filter-chip.selected{background:#2e71cf;color:white;box-shadow:0 6rpx 16rpx #2b6ad125}
.product-card{background:#fff;border-radius:27rpx;padding:19rpx 16rpx 18rpx;border:2rpx solid #dbe4f1;display:flex;flex-direction:column;min-width:0;box-shadow:0 8rpx 20rpx #345b8b09}.product-top{display:flex;justify-content:space-between;align-items:center;font-size:19rpx;margin-bottom:10rpx}.owned-mark{color:#4d9477}.product-stage{height:186rpx;border-radius:21rpx;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative;margin-bottom:13rpx;background:#f4f7fc}.product-image{width:170rpx;height:170rpx}.product-actor{width:180rpx;height:180rpx}.product-name{font-weight:750;font-size:26rpx;line-height:1.45;min-height:76rpx;display:flex;align-items:center;justify-content:center;text-align:center}.product-effect{font-size:21rpx;line-height:1.5;color:#6d81a0;text-align:center;min-height:65rpx}.product-price{background:#eaf1fd;border-radius:17rpx;text-align:center;color:#326ec6;font-size:24rpx;font-weight:700;padding:14rpx 7rpx;margin-top:13rpx}.product-price.is-owned{background:#eaf5f0;color:#4d8871}.product-unlock{text-align:center;font-size:19rpx;color:#8c9ab1;padding-top:9rpx}
.rarity-border-rare{border-color:#a9c8f2}.rarity-border-epic{border-color:#cfb5ee}.rarity-border-legendary{border-color:#dfb457;box-shadow:0 5rpx 25rpx #b5861d18}.rarity-legendary{color:#ac7820}.rarity-bg-common{background:linear-gradient(150deg,#f3f7fc,#eef4fa)}.rarity-bg-rare{background:linear-gradient(150deg,#e9f8ff,#e8edff)}.rarity-bg-epic{background:linear-gradient(150deg,#f2edff,#e4eaff)}.rarity-bg-legendary{background:linear-gradient(150deg,#fff6dc,#fff0ce 48%,#f9e0a8)}
.wish-card{display:flex;align-items:center;gap:18rpx;background:linear-gradient(110deg,#fff,#e7f0ff);border:2rpx solid #d2e1f8;border-radius:26rpx;padding:16rpx 18rpx;margin-bottom:22rpx}.wish-icon{width:112rpx;height:112rpx;flex-shrink:0}.wish-copy{flex:1;min-width:0}.wish-copy .eyebrow{font-size:18rpx;letter-spacing:1rpx}.wish-copy .subtitle{font-size:27rpx}.wish-track{height:8rpx;background:#dbe5f4;border-radius:12rpx;margin:12rpx 0 6rpx;overflow:hidden}.wish-fill{height:100%;background:linear-gradient(90deg,#7db6ee,#3f7fdb);border-radius:12rpx}.wish-arrow{font-size:42rpx;color:#7c9abf}.shop-help .subtitle{margin-bottom:14rpx}.shop-help .muted+.muted{margin-top:14rpx}
.skill-book{position:relative;display:flex;align-items:center;justify-content:center;width:105rpx;height:137rpx;border-radius:7rpx 15rpx 15rpx 7rpx;border:4rpx solid #d9b873;box-shadow:5rpx 7rpx 0 #d2d8e4,8rpx 11rpx 0 #b9c8de;color:#fff5c9;font-size:62rpx;transform:rotate(-7deg)}.book-spine{position:absolute;left:8rpx;top:0;bottom:0;border-right:2rpx solid #fff5c969;width:8rpx}.title-medal{width:95rpx;height:95rpx;display:flex;align-items:center;justify-content:center;border:5rpx double #d4ac4c;background:#f7e4a8;box-shadow:0 0 0 6rpx #edeee8;border-radius:50%;color:#b28628;font-size:54rpx}
.wardrobe-info{flex:1;min-width:0}.slot-note{color:#7f94ad;font-size:21rpx;line-height:1.65;margin-top:10rpx}.collection-themes{background:#fff;border-radius:28rpx;padding:25rpx;margin-bottom:24rpx}.theme-stamps{display:grid;grid-template-columns:repeat(3,1fr);gap:20rpx;margin:20rpx 0}.theme-stamp{border:2rpx dashed #d3e0f1;background:#f4f7fd;border-radius:24rpx;text-align:center;color:#8798b0;padding:13rpx 4rpx;font-size:23rpx}.theme-stamp image{width:80rpx;height:80rpx;opacity:.65}.theme-stamp text{font-size:19rpx}.theme-stamp.complete{border-color:#77b9b0;background:#eaf8f4;color:#2e8475}.theme-stamp.complete image{opacity:1}
.detail-shade{position:fixed;top:0;left:0;right:0;bottom:0;background:#0f244377;z-index:30;display:flex;align-items:flex-end}.detail-sheet{background:#fff;width:100%;height:84vh;border-radius:36rpx 36rpx 0 0;padding:22rpx 28rpx 0;box-shadow:0 -20rpx 50rpx #101e331f}.detail-close{background:#eef3fc;color:#7992b4;width:64rpx;height:64rpx;line-height:56rpx;padding:0;font-size:43rpx;border-radius:50%;flex-shrink:0}.detail-scroll{height:calc(84vh - 105rpx);padding-bottom:env(safe-area-inset-bottom)}.detail-art{height:265rpx;border-radius:26rpx;display:flex;align-items:center;justify-content:center;margin:15rpx 0 16rpx;position:relative}.detail-actor{height:254rpx;width:254rpx}.detail-image{width:235rpx;height:235rpx}.large-book{width:120rpx;height:162rpx}.preview-caption{position:absolute;right:14rpx;bottom:12rpx;color:#7390b7;font-size:18rpx;background:#ffffffa0;border-radius:20rpx;padding:5rpx 12rpx}.detail-name{font-size:34rpx;margin-bottom:4rpx}.detail-effect{color:#3d70b4;background:#edf4ff;border-radius:18rpx;padding:14rpx 18rpx;font-size:25rpx;line-height:1.65;margin:18rpx 0 12rpx}.detail-story{font-size:23rpx}.detail-balance{font-size:24rpx;font-weight:700;color:#a57b2d;margin:17rpx 0 9rpx}.detail-actions{display:flex;gap:14rpx;margin-top:16rpx}.detail-actions button{flex:1;font-size:25rpx;padding:20rpx 12rpx}.detail-foot{font-size:20rpx;color:#8295ae;text-align:center;line-height:1.5;padding:14rpx 0 30rpx}.earn-coins{padding:14rpx;background:transparent;color:#547eba;font-size:23rpx;width:100%}
.dark .shop-front{background:linear-gradient(155deg,#263c59,#26365a);border-color:#3e5c80}.dark .shop-title{color:#e4edff}.dark .shop-label,.dark .shop-talk{color:#b5cbe6}.dark .awning{background:repeating-linear-gradient(90deg,#4075b4 0,#4075b4 52rpx,#b5c6df 52rpx,#b5c6df 104rpx)}.dark .product-card,.dark .collection-themes{background:#1c304b}.dark .rarity-bg-common{background:#263a54}.dark .rarity-bg-rare{background:linear-gradient(150deg,#29445d,#30416b)}.dark .rarity-bg-epic{background:linear-gradient(150deg,#44345e,#34456b)}.dark .rarity-bg-legendary{background:linear-gradient(150deg,#615038,#4a423a)}.dark .product-effect{color:#b2c6df}.dark .product-price{background:#2d486b;color:#c4ddff}.dark .wish-card{background:linear-gradient(110deg,#213951,#263e60);border-color:#486187}.dark .theme-stamp{background:#253b57;border-color:#476084}.dark .theme-stamp.complete{background:#244b47;color:#a0dac5}.dark .filter-chip{background:#28425f;color:#bfd2ea}.dark .filter-chip.selected{background:#3d7bdd;color:#fff}.dark .detail-sheet{background:#1b2d46}.dark .detail-effect{background:#29476a;color:#c9e1ff}.dark .detail-close{background:#304965;color:#bed2ec}
.detail-close{flex:0 0 64rpx;min-width:64rpx;max-width:64rpx;width:64rpx;margin:0}
