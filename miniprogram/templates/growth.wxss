.growth-banner{background:linear-gradient(145deg,#deefff,#eee9ff);border:2rpx solid #c9d9f1;border-radius:30rpx;display:flex;align-items:center;padding:20rpx 14rpx 20rpx 0;margin-bottom:27rpx}.growth-cat{width:240rpx;height:240rpx;flex-shrink:0}.growth-copy{flex:1;min-width:0}.growth-copy .eyebrow{font-size:18rpx;letter-spacing:0}.growth-copy .title{font-size:35rpx;margin:8rpx 0}.growth-next{font-size:21rpx;line-height:1.6;color:#577dab;margin-top:15rpx}.ink-count{font-size:21rpx;color:#6f75b6;background:#e7e6f9;border-radius:100rpx;padding:9rpx 16rpx}.skill-card{background:#fff;border:2rpx solid #d8e4f5;border-radius:27rpx;padding:23rpx;margin-bottom:18rpx}.skill-locked{background:#f8faff;border-style:dashed}.skill-card-head{display:flex;gap:18rpx;align-items:center}.skill-emblem{display:flex;align-items:center;justify-content:center;width:79rpx;height:79rpx;flex-shrink:0;border-radius:22rpx;color:#fff5d6;border:3rpx solid #d9c29b;font-size:42rpx}.skill-card-copy{flex:1}.skill-status{font-size:20rpx;color:#6785ad}.skill-description{font-size:24rpx;line-height:1.7;margin:17rpx 0;color:#59728f}.skill-actions{display:flex;flex-wrap:wrap;gap:10rpx}.skill-actions button{font-size:21rpx;padding:14rpx 13rpx;flex:1;min-width:140rpx}.skill-actions .skill-place{background:#f1f5fa;color:#6682a7;opacity:1;flex:1.4;font-weight:400}.growth-goal{background:#fff;border-radius:25rpx;border:2rpx solid #dce6f4;padding:16rpx;margin-bottom:16rpx;display:flex;align-items:center;gap:15rpx}.goal-icon{width:125rpx;height:125rpx;flex-shrink:0}.goal-copy{flex:1;min-width:0}.goal-copy .subtitle{font-size:27rpx}.goal-complete{border-color:#8bbfb2}.growth-goals{margin-bottom:26rpx}.next-growth{display:flex;align-items:center;gap:20rpx;background:#fff;border:2rpx solid #d6e6f8;border-radius:24rpx;padding:18rpx 24rpx;margin:20rpx 0}.next-growth-symbol{font-size:36rpx;color:#6e8de3}.next-growth-copy{flex:1}.next-growth-copy .subtitle{font-size:26rpx}.next-growth-copy .muted{font-size:21rpx}.profile-info{cursor:pointer}.profile-growth{font-size:19rpx;color:#809abb;margin-top:6rpx}.bottom-nav>view{width:18%}.dark .growth-banner{background:linear-gradient(145deg,#273b58,#3b3152);border-color:#4f6080}.dark .growth-next{color:#b7cce8}.dark .skill-card,.dark .growth-goal,.dark .next-growth{background:#1c304b;border-color:#3b5474}.dark .skill-locked{background:#1c2e46}.dark .skill-description{color:#bbcee5}.dark .skill-actions .skill-place{background:#2b415e;color:#b0c8e7}.dark .ink-count{background:#3a3b5b;color:#cbcef1}
