<view wx:if="{{modern}}" class="card"><view class="subtitle">今日学习 {{daily600.count}} / {{daily600.target}} 题</view><view class="muted">{{daily600.qualified?'今日目标已完成':'再完成 '+daily600.remaining+' 道不同题即可达标'}} · 连续达标 {{daily600.streak}} 天</view><view class="muted">完成作答计入活跃题数；同题不重复计数。未达标日，每位已加入伙伴减少10点体力，新加入当天免除。</view><view wx:if="{{daily600.offline.points}}" class="muted">上次离线结算：{{daily600.offline.days}} 个未达标日，合计消耗 {{daily600.offline.points}} 点体力。</view></view>
<view class="growth-banner"><view class="growth-cat"><cat-actor skin="{{g.skin||'xiaoyuan'}}" pose="celebrate" outfit="{{g.outfit||''}}" xp="{{g.equipment.xp||''}}" coins="{{g.equipment.coins||''}}" wonder="{{g.equipment.wonder||''}}"/></view><view class="growth-copy"><view class="eyebrow">每一份努力，都在长大</view><view class="title">Lv.{{stats.level}} {{growthTitle}}</view><view class="muted">本级 {{xpInLevel}} / {{xpRequired}} 经验</view><view class="xp-track"><view class="xp-bar" style="width:{{xpProgress}}%"/></view></view></view>
<view class="row section-heading"><view class="subtitle">小圆的魔法手册</view><text class="muted">最多携带三项主动技能</text></view>
<view class="skill-list"><view wx:for="{{skills}}" wx:key="id" class="skill-card"><view class="skill-card-head"><view class="skill-card-copy"><view class="subtitle">{{item.name}} · {{item.rank}} / 4阶</view><view class="muted small">{{item.passive?'被动技能 · 不占主动位':item.equipped?'本场携带配置':'主动技能'}}</view></view></view><view class="skill-description">{{item.description}}</view><view class="muted">{{item.maxed?'已达最高阶':'Lv.'+item.requiredLevel+' 可学第'+(item.rank+1)+'阶 · '+item.price+' 金币'}}</view><view class="skill-actions"><button wx:if="{{item.rank&&!item.passive}}" class="{{item.equipped?'primary':'secondary'}}" data-id="{{item.id}}" bindtap="equipSkill">{{item.equipped?'卸下技能':'携带技能'}}</button><button wx:if="{{!item.maxed}}" class="secondary" data-id="{{'skill:'+item.id}}" bindtap="itemAction" disabled="{{!item.canLearn}}">{{item.rank?'永久升阶':'永久学习'}} · {{item.price}}金币</button></view></view></view>
<view class="card muted">等级成长逐渐增加所需经验。技能用金币永久学习，每十级可进阶一次。魔法在Lv.10解锁；施法时扣魔法，每题同一技能只能使用一次。开场已携带的技能与阶数保持到本场结束。</view>
<view class="row section-heading"><view class="subtitle">奇物工坊 · 逐步上架</view><text class="muted small">解锁商品，攒钱拥有</text></view>
<view class="growth-goals"><view wx:for="{{milestones}}" wx:key="id" class="growth-goal {{item.owned?'goal-complete':''}}" data-id="{{item.item}}" bindtap="openItem"><image class="goal-icon" src="{{item.icon}}" mode="aspectFit"/><view class="goal-copy"><view class="subtitle">{{item.name}}</view><view class="rarity-{{item.rarity}} small">{{item.rarityName}} · {{item.price}} 金币</view><view class="muted small">{{item.owned?'已拥有，去背包装备':item.unlocked?'已经上架':'通关 '+item.clears+' 关后上架'}}</view><view class="wish-track"><view class="wish-fill" style="width:{{item.progress}}%"/></view></view><text class="wish-arrow">{{item.owned?'✓':'›'}}</text></view></view>
<button class="primary" bindtap="openShop">去小团的旅行小铺 →</button>
