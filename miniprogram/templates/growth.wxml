<view class="growth-banner"><view class="growth-cat"><cat-actor skin="{{g.skin}}" pose="celebrate" outfit="{{g.outfit||''}}" xp="{{g.equipment.xp||''}}" coins="{{g.equipment.coins||''}}" wonder="{{g.equipment.wonder||''}}"/></view><view class="growth-copy"><view class="eyebrow">每一份努力，都在长大</view><view class="title">Lv.{{stats.level}} 冒险者</view><view class="muted">本级 {{xpInLevel}} / 500 经验</view><view class="xp-track"><view class="xp-bar" style="width:{{xpProgress}}%"/></view><view class="growth-next">{{nextSkill?'再积累 '+nextSkill.xpRemaining+' 经验，学会「'+nextSkill.name+'」':'五种技能已学会，向更远处出发！'}}</view></view></view>
<view class="row section-heading"><view class="subtitle">小圆的魔法手册</view><text class="ink-count">魔法墨水 {{ink}} 滴</text></view>
<view class="skill-list"><view wx:for="{{skills}}" wx:key="id" class="skill-card {{!item.unlocked?'skill-locked':''}}"><view class="skill-card-head"><view class="skill-emblem" style="background:{{item.color}}">{{item.glyph}}</view><view class="skill-card-copy"><view class="subtitle">{{item.name}}</view><view class="muted small">Lv.{{item.level}} 学会 · {{item.unlocked?'剩余 '+item.charges+' 次':'还差 '+item.xpRemaining+' 经验'}}</view></view><text class="skill-status">{{item.unlocked?'已学会':'待解锁'}}</text></view><view class="skill-description">{{item.description}}</view><view wx:if="{{item.unlocked}}" class="skill-actions"><button wx:if="{{item.type==='boost'}}" class="{{item.queued?'primary':'secondary'}}" data-id="{{item.id}}" bindtap="queueSkill" disabled="{{!item.charges&&!item.queued}}">{{item.queued?'已备好 · 点击取消':'备好下一场'}}</button><button wx:else class="skill-place" disabled>{{item.type==='clear'?'失败结算时使用':item.type==='hint'?'客观题页面使用':'主观题参考答案旁使用'}}</button><button class="secondary" data-id="{{item.id}}" bindtap="refillInk" disabled="{{!ink}}">墨水 +1 次</button><button class="secondary" data-id="{{'skill:'+item.id}}" bindtap="openItem">{{item.price}} 金币补充</button></view></view></view>
<view class="card muted">每升一级需要 500 经验。达到指定等级自动学会技能，初始可用一次；墨水来自低概率惊喜，也能用金币补充。技能效果与真实作答成绩分别显示。</view>
<view class="row section-heading"><view class="subtitle">奇物工坊 · 逐步上架</view><text class="muted small">解锁商品，攒钱拥有</text></view>
<view class="growth-goals"><view wx:for="{{milestones}}" wx:key="id" class="growth-goal {{item.owned?'goal-complete':''}}" data-id="{{item.item}}" bindtap="openItem"><image class="goal-icon" src="{{item.icon}}" mode="aspectFit"/><view class="goal-copy"><view class="subtitle">{{item.name}}</view><view class="rarity-{{item.rarity}} small">{{item.rarityName}} · {{item.price}} 金币</view><view class="muted small">{{item.owned?'已拥有，去背包装备':item.unlocked?'已经上架，努力赚金币吧':'通关 '+item.clears+' 关后上架 · 还差 '+item.remaining+' 关'}}</view><view class="wish-track"><view class="wish-fill" style="width:{{item.progress}}%"/></view></view><text class="wish-arrow">{{item.owned?'✓':'›'}}</text></view></view>
<button class="primary" bindtap="openShop">去小团的旅行小铺 →</button>
