<view class="card"><view class="title">星光经营小镇</view><view class="muted">小圆、小团和小宝一起修复星光账本。财管每章首次完成获得3份建材。</view><view class="row"><view class="number">{{finance.state.materials}} <text class="muted">份建材</text></view><button class="secondary compact" bindtap="openFormulas">公式图鉴</button></view></view>
<view class="card"><view class="subtitle">六幕故事 · 可跳过、可回看</view><view wx:for="{{finance.acts}}" wx:key="id" class="town-row"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"/><view class="town-copy"><view class="subtitle">{{item.name}} · {{item.npc_name}} {{item.completed?'✓':''}}</view><view class="muted">{{item.theme}}</view><button class="secondary" disabled="{{!item.open}}" data-id="{{item.id}}" bindtap="viewStory">{{item.open?item.seen?'回看剧情':'阅读剧情':'完成前置章节后开放'}}</button></view></view></view>
<view class="card"><view class="subtitle">我的小镇建筑</view><view wx:for="{{finance.buildings}}" wx:key="id" class="town-row"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"/><view class="town-copy"><view>{{item.name}} · {{item.level}} / 3级</view><view class="muted">{{item.levelName}}</view><button class="primary" disabled="{{!item.canBuild}}" data-id="{{item.id}}" bindtap="buildTown">{{item.level===3?'星光地标已完成':'升级 · '+item.cost+'份建材'}}</button></view></view></view>
<view class="card"><view class="subtitle">经营委托 · 完成后获得明信片</view><view wx:for="{{finance.commissions}}" wx:key="id" class="town-commission"><view>{{item.name}}</view><view class="muted">{{item.prompt}}</view><button wx:if="{{item.ready}}" class="primary" data-id="{{item.id}}" bindtap="claimCommission">领取明信片</button><button wx:else class="secondary" disabled="{{!item.open||item.claimed}}" data-id="{{item.id}}" bindtap="commission">{{item.claimed?'明信片已收入背包':item.open?'开始委托 · '+item.amount+'题':'剧情开放后可接取'}}</button></view></view>
<view class="card"><view class="subtitle">精灵伙伴 · 同时携带一位</view><view wx:for="{{finance.companions}}" wx:key="id" class="town-row"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"/><view class="town-copy"><view>{{item.name}} · {{item.role}}</view><view class="muted">{{item.story}}</view><button wx:if="{{item.owned}}" class="{{item.equipped?'primary':'secondary'}}" data-id="{{item.id}}" bindtap="equipSpirit">{{item.equipped?'陪伴中 · 收起':'带上这位伙伴'}}</button><button wx:else class="secondary" disabled="{{!item.canBuy}}" data-id="{{item.id}}" bindtap="recruitSpirit">{{item.unlocked?'招募 · '+item.price+'金币':'完成第'+item.unlock_chapter+'章后招募'}}</button></view></view><button class="primary" bindtap="rescue">{{rescueCount?'错题救援 · 当前科目'+rescueCount+'题':'当前科目错题救援已完成'}}</button><view wx:for="{{finance.state.diary}}" wx:key="id" class="muted">伙伴日记 · {{item.correct}} / {{item.total}}题掌握</view></view>
<view class="card"><view class="subtitle">学习工具与小镇摆件</view><view wx:for="{{finance.props}}" wx:key="id" class="town-row"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"/><view class="town-copy"><view>{{item.name}} {{item.owned?'✓':''}}</view><view class="muted">{{item.story}}</view><button wx:if="{{item.kind==='tool'}}" class="secondary" data-utility="{{item.utility}}" bindtap="utility">打开{{item.utility==='formulas'?'公式图鉴':item.utility==='scratch'?'计算草稿':item.utility==='focus'?'专注计时':'复习清单'}}</button><button wx:if="{{!item.owned}}" class="secondary" data-id="{{item.id}}" bindtap="openItem">{{item.price}}金币 · 查看</button></view></view><view class="muted">学习工具始终可用。金币兑换让道具和摆件加入收藏。</view></view>
<view wx:if="{{townStory}}" class="story-veil" bindtap="closeStory"><view class="story-card" catchtap="noop"><view class="subtitle">{{townStory.name}}</view><scroll-view scroll-y class="story-scroll"><view wx:for="{{townStory.lines}}" wx:key="index" class="story-line"><view class="subtitle">{{item.speaker}}</view><view>{{item.text}}</view></view></scroll-view><button class="primary" bindtap="closeStory">继续冒险</button><button class="secondary" bindtap="closeStory">跳过 · 以后回看</button></view></view>
