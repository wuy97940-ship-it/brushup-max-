<view class="card"><view class="title">公式图鉴</view><view class="muted">公式、符号含义、条件和易错点随章节开放。可独立进入。</view><button class="secondary" bindtap="openTown">返回经营小镇</button></view>
<view class="card" wx:for="{{formulaChapters}}" wx:key="chapter_no"><view class="subtitle">第{{item.chapter_no}}章 · {{item.title||item.name}}</view><view wx:if="{{!item.open}}" class="muted">完成前面的财管章节后点亮</view><block wx:else><view wx:for="{{item.formulas}}" wx:for-item="formula" wx:key="index" class="formula-entry"><text user-select>{{formula.name||formula.title}}</text><text class="formula-text" user-select>{{formula.expression}}</text><view class="muted">符号 · {{formula.symbolsText}}</view><view>条件 · {{formula.conditionsText}}</view><view class="muted">易错点 · {{formula.pitfallsText}}</view></view><button class="secondary" disabled="{{item.seen}}" data-chapter="{{item.chapter_no}}" bindtap="seeFormulas">{{item.seen?'本章公式已复习':'标记本章公式已复习'}}</button></block></view>
